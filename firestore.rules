rules_version = '2';

// Суд Проклятий - правила Firestore.
// Вставить в Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /matches/{code} {

      function isMember() {
        return request.auth.uid in resource.data.members;
      }

      // код, создатель и разумный размер стола не меняются
      function keepsIdentity() {
        return request.resource.data.code == resource.data.code
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.members.size() <= 12;
      }

      // новичок может только сесть: добавить себя в members, занять место, записать ник
      function joining() {
        return !(request.auth.uid in resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seats', 'members', 'names', 'updatedAt']);
      }

      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.code == code
        && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn() && keepsIdentity() && (isMember() || joining());
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      // кто сейчас в зале
      match /presence/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // стикеры
      match /events/{eventId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.t is string
          && request.resource.data.t.size() <= 16
          && request.resource.data.at == request.time;
      }
    }

    // кошелёк печатей и купленные коллекции: видит и меняет только хозяин
    match /players/{uid} {
      function sane() {
        return request.resource.data.seals is number
          && request.resource.data.seals >= 0
          && request.resource.data.owned is list
          && request.resource.data.owned.size() <= 64;
      }
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && sane()
        && request.resource.data.seals <= 10;
      allow update: if signedIn() && request.auth.uid == uid && sane();
    }
  }
}
